# Server-side Firebase configuration only. Do not expose these values to the
# Vite browser app or add a client-side environment-variable prefix.
#
# Keep this file as a template for the API/server that owns Firebase access;
# the current static frontend runs in local demo mode.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
